# Firebase Admin SDK service account (Firebase console → Project Settings →
# Service Accounts → Generate new private key). Used by lib/firebase-admin.ts
# for trusted server-only Firestore access — bypasses security rules
# entirely, so invoice/client data is never reachable from a browser.
# PRIVATE_KEY keeps its \n escapes as a single-line env var value; the code
# unescapes them at runtime.
# Canonical production URL — read by lib/site.ts (SITE_URL). Falls back to
# https://www.faruqcodes.com if unset, but every deploy target should set
# this explicitly. No trailing slash.
SITE_URL=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin login for /admin. ADMIN_PASSWORD_HASH is a bcrypt hash — never store
# the plaintext password anywhere. IMPORTANT: escape every literal $ in the
# hash as \$ (e.g. \$2b\$10\$...) — Next's env loader treats unescaped $X as
# variable interpolation and silently resolves it to an empty string if no
# such variable exists, which breaks login with no obvious error.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Random 32+ byte string used to sign the admin session JWT (jose, HS256).
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Paystack secret key. sk_test_... in development, sk_live_... in production.
PAYSTACK_SECRET_KEY=

# Server-only Brevo API key for sending invoice emails (lib/email.ts).
# Deliberately separate from the existing NEXT_PUBLIC_BREVOKEY used by the
# contact form in app/api/brevo/route.ts — that one is untouched by this
# feature.
BREVO_API_KEY=
